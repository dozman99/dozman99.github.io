   "locked": false,
   "text": "dozlab-api never builds pods or talks to the VM: it creates one LabSession, the controller does the rest.",
   "originalText": "dozlab-api never builds pods or talks to the VM: it creates one LabSession, the controller does the rest.",
   "fontSize": 16,
